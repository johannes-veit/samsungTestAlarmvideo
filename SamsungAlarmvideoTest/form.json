{
  "elements": [
    {
      "type": "Label",
      "caption": "v0.2.0: direktes Update von v0.1.6. WakeUp bleibt unverändert. Das Video wird jetzt über einen eigenen kleinen DLNA/HTTP-Medienserver auf der SymBox ausgeliefert. Die technische Hilfsinstanz und der Server Socket werden automatisch erstellt und verborgen."
    },
    {
      "type": "SelectInstance",
      "name": "SamsungInstanceID",
      "caption": "SamsungTizen Instanz"
    },
    {
      "type": "SelectVariable",
      "name": "TVStatusVariableID",
      "caption": "Samsung TV Status (Boolean)",
      "validVariableTypes": [0]
    },
    {
      "type": "ValidationTextBox",
      "name": "TVIP",
      "caption": "IP-Adresse Samsung TV"
    },
    {
      "type": "ValidationTextBox",
      "name": "SymconIP",
      "caption": "IP-Adresse SymBox"
    },
    {
      "type": "NumberSpinner",
      "name": "MediaServerPort",
      "caption": "DLNA-Medienserver Port",
      "minimum": 1025,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "StartDelayMs",
      "caption": "Video-Startverzögerung nach TV-Start",
      "suffix": "ms",
      "minimum": 0,
      "maximum": 30000
    },
    {
      "type": "CheckBox",
      "name": "LoopVideo",
      "caption": "Alarmvideo in Endlosschleife"
    },
    {
      "type": "Label",
      "caption": "Standard-Port 8090. Es ist keine PowerShell, kein Tizen Studio und kein weiteres GitHub-Modul nötig."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "DLNA-Medienserver prüfen/einrichten",
      "onClick": "echo SAVT_PrepareVideo($id);"
    },
    {
      "type": "Button",
      "caption": "1. Nur TV aufwecken",
      "onClick": "echo SAVT_WakeTV($id);"
    },
    {
      "type": "Button",
      "caption": "2. Nur Alarmvideo starten (TV EIN)",
      "onClick": "echo SAVT_StartVideoNow($id);"
    },
    {
      "type": "Button",
      "caption": "Kompletttest: TV + Alarmvideo",
      "onClick": "echo SAVT_TestVideo($id);"
    },
    {
      "type": "Button",
      "caption": "Alarmvideo stoppen",
      "onClick": "echo SAVT_StopVideo($id);"
    }
  ]
}
