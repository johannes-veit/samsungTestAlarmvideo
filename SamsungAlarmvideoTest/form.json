{
  "elements": [
    {
      "type": "Label",
      "caption": "v0.1.3: kein WebHook mehr. Das Video wird als normale statische Datei im Symcon-user-Ordner bereitgestellt. WakeUp nutzt exakt SamsungTizen_WakeUp()."
    },
    {
      "type": "SelectInstance",
      "name": "SamsungInstanceID",
      "caption": "SamsungTizen Instanz"
    },
    {
      "type": "SelectVariable",
      "name": "TVStatusVariableID",
      "caption": "Samsung TV Status (Boolean)",
      "validVariableTypes": [0]
    },
    {
      "type": "ValidationTextBox",
      "name": "TVIP",
      "caption": "IP-Adresse Samsung TV"
    },
    {
      "type": "ValidationTextBox",
      "name": "SymconIP",
      "caption": "IP-Adresse SymBox"
    },
    {
      "type": "NumberSpinner",
      "name": "WebPort",
      "caption": "Symcon WebServer Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "StartDelayMs",
      "caption": "Video-Startverzögerung nach TV-Start",
      "suffix": "ms",
      "minimum": 0,
      "maximum": 30000
    },
    {
      "type": "Label",
      "caption": "Statische Video-URL nach Übernehmen: http://192.168.103.59:3777/user/samsung-alarmvideo/ALARM.mp4"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Video-Datei neu bereitstellen",
      "onClick": "echo SAVT_PrepareVideo($id);"
    },
    {
      "type": "Button",
      "caption": "1. Nur TV aufwecken",
      "onClick": "echo SAVT_WakeTV($id);"
    },
    {
      "type": "Button",
      "caption": "2. Nur Alarmvideo starten (TV EIN)",
      "onClick": "echo SAVT_StartVideoNow($id);"
    },
    {
      "type": "Button",
      "caption": "Kompletttest: TV + Alarmvideo",
      "onClick": "echo SAVT_TestVideo($id);"
    },
    {
      "type": "Button",
      "caption": "Video stoppen",
      "onClick": "echo SAVT_StopVideo($id);"
    }
  ]
}
