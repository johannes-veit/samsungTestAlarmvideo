{
  "elements": [
    {
      "type": "Label",
      "caption": "Einfacher Einzeltest. Keine PowerShell nötig. Die bestehende LCN Alarmanlage wird nicht verändert."
    },
    {
      "type": "SelectInstance",
      "name": "SamsungInstanceID",
      "caption": "SamsungTizen Instanz"
    },
    {
      "type": "SelectVariable",
      "name": "TVStatusVariableID",
      "caption": "Samsung TV Status (Boolean)",
      "validVariableTypes": [0]
    },
    {
      "type": "ValidationTextBox",
      "name": "TVIP",
      "caption": "IP-Adresse Samsung TV"
    },
    {
      "type": "ValidationTextBox",
      "name": "SymconIP",
      "caption": "IP-Adresse SymBox"
    },
    {
      "type": "NumberSpinner",
      "name": "WebPort",
      "caption": "Symcon WebServer Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "StartDelayMs",
      "caption": "Video-Startverzögerung nach TV-Start",
      "suffix": "ms",
      "minimum": 0,
      "maximum": 30000
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "Zum Testen sind TV-Start und Video absichtlich getrennt. So ist sofort erkennbar, welcher Teil funktioniert."
    },
    {
      "type": "Button",
      "caption": "1. Nur TV aufwecken",
      "onClick": "echo SAVT_WakeTV($id);"
    },
    {
      "type": "Button",
      "caption": "2. Nur Alarmvideo starten (TV muss EIN sein)",
      "onClick": "echo SAVT_StartVideoNow($id);"
    },
    {
      "type": "Button",
      "caption": "Kompletttest: TV + Alarmvideo",
      "onClick": "echo SAVT_TestVideo($id);"
    },
    {
      "type": "Button",
      "caption": "Video stoppen",
      "onClick": "echo SAVT_StopVideo($id);"
    }
  ]
}
