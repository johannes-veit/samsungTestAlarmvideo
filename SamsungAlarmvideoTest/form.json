{
  "elements": [
    {
      "type": "Label",
      "caption": "v0.1.5: Der Samsung bekommt jetzt echte Medien-URLs mit Dateiendung (.mp4 / .mpeg) statt einer ?format=-URL. MP4 und MPEG-Fallback wurden passend zu den beim funktionierenden Windows-DLNA-Test gesehenen Profilen vorbereitet. WakeUp bleibt unverändert."
    },
    {
      "type": "SelectInstance",
      "name": "SamsungInstanceID",
      "caption": "SamsungTizen Instanz"
    },
    {
      "type": "SelectVariable",
      "name": "TVStatusVariableID",
      "caption": "Samsung TV Status (Boolean)",
      "validVariableTypes": [
        0
      ]
    },
    {
      "type": "ValidationTextBox",
      "name": "TVIP",
      "caption": "IP-Adresse Samsung TV"
    },
    {
      "type": "ValidationTextBox",
      "name": "SymconIP",
      "caption": "IP-Adresse SymBox"
    },
    {
      "type": "NumberSpinner",
      "name": "WebPort",
      "caption": "Symcon WebServer Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "StartDelayMs",
      "caption": "Video-Startverzögerung nach TV-Start",
      "suffix": "ms",
      "minimum": 0,
      "maximum": 30000
    },
    {
      "type": "Label",
      "caption": "Der Modulstatus und 'Letzter Videoabruf' zeigen, ob Samsung die neue .mp4/.mpeg-URL tatsächlich abruft."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "DLNA-Videoquelle prüfen",
      "onClick": "echo SAVT_PrepareVideo($id);"
    },
    {
      "type": "Button",
      "caption": "1. Nur TV aufwecken",
      "onClick": "echo SAVT_WakeTV($id);"
    },
    {
      "type": "Button",
      "caption": "2. Nur Alarmvideo starten (TV EIN)",
      "onClick": "echo SAVT_StartVideoNow($id);"
    },
    {
      "type": "Button",
      "caption": "Kompletttest: TV + Alarmvideo",
      "onClick": "echo SAVT_TestVideo($id);"
    },
    {
      "type": "Button",
      "caption": "Video stoppen",
      "onClick": "echo SAVT_StopVideo($id);"
    }
  ]
}
