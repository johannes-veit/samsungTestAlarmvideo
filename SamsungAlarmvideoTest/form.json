{
  "elements": [
    {
      "type": "Label",
      "caption": "v0.1.6: DLNA/AVTransport wird nicht mehr verwendet. Das Modul startet den Samsung-Internetbrowser direkt über den bereits vorhandenen SamsungTizen-WebSocket und öffnet dort einen Vollbild-Alarmplayer. WakeUp bleibt unverändert."
    },
    {
      "type": "SelectInstance",
      "name": "SamsungInstanceID",
      "caption": "SamsungTizen Instanz"
    },
    {
      "type": "SelectVariable",
      "name": "TVStatusVariableID",
      "caption": "Samsung TV Status (Boolean)",
      "validVariableTypes": [
        0
      ]
    },
    {
      "type": "ValidationTextBox",
      "name": "TVIP",
      "caption": "IP-Adresse Samsung TV"
    },
    {
      "type": "ValidationTextBox",
      "name": "SymconIP",
      "caption": "IP-Adresse SymBox"
    },
    {
      "type": "NumberSpinner",
      "name": "WebPort",
      "caption": "Symcon WebServer Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "StartDelayMs",
      "caption": "Video-Startverzögerung nach TV-Start",
      "suffix": "ms",
      "minimum": 0,
      "maximum": 30000
    },
    {
      "type": "Label",
      "caption": "Der Browser-Player startet ALARM.mp4 automatisch mit Ton und Loop. Falls der erste Browserstart nicht greift, erfolgt genau ein automatischer Retry mit der 2020er Internet-App-ID."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Videoquelle/Player prüfen",
      "onClick": "echo SAVT_PrepareVideo($id);"
    },
    {
      "type": "Button",
      "caption": "1. Nur TV aufwecken",
      "onClick": "echo SAVT_WakeTV($id);"
    },
    {
      "type": "Button",
      "caption": "2. Nur Alarmvideo starten (TV EIN)",
      "onClick": "echo SAVT_StartVideoNow($id);"
    },
    {
      "type": "Button",
      "caption": "Kompletttest: TV + Alarmvideo",
      "onClick": "echo SAVT_TestVideo($id);"
    },
    {
      "type": "Button",
      "caption": "Browser / Video beenden",
      "onClick": "echo SAVT_StopVideo($id);"
    }
  ]
}
