{
  "elements": [
    {
      "type": "Label",
      "caption": "v0.1.4: Video wird jetzt über einen eigenen DLNA-tauglichen HTTP-Endpunkt mit HEAD/GET, Byte-Range und DLNA-Headern ausgeliefert. Kein /user-Pfad mehr. WakeUp bleibt unverändert über SamsungTizen_WakeUp()."
    },
    {
      "type": "SelectInstance",
      "name": "SamsungInstanceID",
      "caption": "SamsungTizen Instanz"
    },
    {
      "type": "SelectVariable",
      "name": "TVStatusVariableID",
      "caption": "Samsung TV Status (Boolean)",
      "validVariableTypes": [0]
    },
    {
      "type": "ValidationTextBox",
      "name": "TVIP",
      "caption": "IP-Adresse Samsung TV"
    },
    {
      "type": "ValidationTextBox",
      "name": "SymconIP",
      "caption": "IP-Adresse SymBox"
    },
    {
      "type": "NumberSpinner",
      "name": "WebPort",
      "caption": "Symcon WebServer Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "StartDelayMs",
      "caption": "Video-Startverzögerung nach TV-Start",
      "suffix": "ms",
      "minimum": 0,
      "maximum": 30000
    },
    {
      "type": "Label",
      "caption": "Der Modulstatus und die Variablen 'Letzter Videoabruf' / 'Videoabrufe' zeigen, ob der Samsung die Videoquelle tatsächlich vom Symcon-Modul anfordert."
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "DLNA-Videoquelle prüfen",
      "onClick": "echo SAVT_PrepareVideo($id);"
    },
    {
      "type": "Button",
      "caption": "1. Nur TV aufwecken",
      "onClick": "echo SAVT_WakeTV($id);"
    },
    {
      "type": "Button",
      "caption": "2. Nur Alarmvideo starten (TV EIN)",
      "onClick": "echo SAVT_StartVideoNow($id);"
    },
    {
      "type": "Button",
      "caption": "Kompletttest: TV + Alarmvideo",
      "onClick": "echo SAVT_TestVideo($id);"
    },
    {
      "type": "Button",
      "caption": "Video stoppen",
      "onClick": "echo SAVT_StopVideo($id);"
    }
  ]
}
